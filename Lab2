deque<packaged_task<int(int)>> taskDeque;
deque<int> nDeque;
mutex m;
condition_variable cv;
bool done = false;

void Worker() {
    while (true) {
        packaged_task<int(int)> task;
        int n;
            unique_lock<mutex> lk(m);
            cv.wait(lk, [] { return !taskDeque.empty() || done; });

            if (done && taskDeque.empty()) {
                break;
            }
            task = move(taskDeque.front());
            taskDeque.pop_front();

            n = nDeque.front();
            nDeque.pop_front();

        future<int> fut = task.get_future();

        task(n);
        cout << "[Потік обробки] " << n << "-те просте число: " << fut.get() << "\n";
    }
}

int main() {
    SetConsoleOutputCP(1251);
    thread workerThread(Worker);

    cout << "Вводьте номери n для пошуку простих чисел. Для завершення введіть стоп-символ '/'\n";
    while (true) {
       string cmd;
       cin >> cmd;
       if (cmd == "/") {
           break; 
       }
       try {
           int x = stoi(cmd);

           {
               unique_lock<mutex> lk(m);
               packaged_task<int(int)> pt(CalcSimpleNum);
               taskDeque.push_back(move(pt));
               nDeque.push_back(x);
           }
           cv.notify_one();

       }
       catch (const invalid_argument&) {
           cout << "Некоректний ввід. Будь ласка, введіть число або '/'.\n";
       }
    }
    
    {
        lock_guard<mutex> lk(m);
        done = true;
        cv.notify_one();
    }
    workerThread.join();
    cout << "Усі обчислення завершено.\n";

    return 0;
}


