//task6
int CalcSimpleNum(int n) {
    if (n <= 0) throw invalid_argument("n має бути додатним");
    vector<int> num(n);
    num[0] = 2;
    int N = 1;
    int Num = 3;
    while (N < n) {
        bool isPrime = true;
        for (int j = 0; j < N; j++) {
            if (num[j] * num[j] > Num) break;
            if (Num % num[j] == 0) { isPrime = false; break; }
        }
        if (isPrime) num[N++] = Num;
        Num += 2;
    }
    return num[n - 1];
}

deque<packaged_task<int(int)>> taskDeque;
deque<int> nDeque;
mutex m;
condition_variable cv;
bool done = false;

void Worker() {
    while (true) {
        packaged_task<int(int)> task;
        int n;
        {  
            unique_lock<mutex> lk(m);
            cv.wait(lk, [] { return !taskDeque.empty() || done; });
            if (done && taskDeque.empty()) break;
            task = move(taskDeque.front());
            taskDeque.pop_front();
            n = nDeque.front();
            nDeque.pop_front();
        }
        future<int> fut = task.get_future();
        task(n);  
        try {
            cout << "[Потік обробки] " << n << "-те просте число: " << fut.get() << "\n";
        }
        catch (const exception& e) {
            cout << "[Потік обробки] Помилка для n=" << n << ": " << e.what() << "\n";
        }
    }
}

int main() {
    SetConsoleOutputCP(1251);
