int CalcSimpleNum(int n) {
    vector<int> num(n);
    num[0] = 2;
    int N = 1;
    int Num = 3;
    for (int i = 0;N < n;i++) {
        bool isPrime = true;
        for (int j = 0; j < N; j++) {
            if (num[j] * num[j] > Num) { break; }
            if (Num % num[j] == 0) { isPrime = false;break; }
        }
        if (isPrime) {
            num[N] = Num;
            N++;
        }
        Num += 2;
    }
    return num[n-1];

    //auto s= find(num.begin(), num.end(), n);

}

