        if (cmd == "/") break;
        try {
            int x = stoi(cmd);
            if (x <= 0) { cout << "n має бути додатним.\n"; continue; }
            {
                lock_guard<mutex> lk(m);
                taskDeque.emplace_back(CalcSimpleNum);
                nDeque.push_back(x);
            }
            cv.notify_one();
        }
        catch (const invalid_argument&) {
            cout << "Некоректний ввід. Будь ласка, введіть число або '/'.\n";
        }
        catch (const out_of_range&) {
            cout << "Число занадто велике.\n";
        }
    }

    {
        lock_guard<mutex> lk(m);
        done = true;
    }
    cv.notify_one();
    workerThread.join();   
    cout << "Усі обчислення завершено.\n";
    return 0;
}


