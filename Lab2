//task4
std::queue<int> dataQueue;
condition_variable dataCond;
mutex m;

void DataPreparation() {
    while (true) {
        cout << "Введіть число або '/' для завершення: ";
        string input;
        cin >> input; 

        if (input == "/") {
            {
                std::lock_guard<std::mutex> lk(m);
                dataQueue.push(-1); 
            }
            dataCond.notify_one();
            break;
        }

        try {
            int x = stoi(input);
            {
                std::lock_guard<std::mutex> lk(m);
                dataQueue.push(x);
            }
            dataCond.notify_one();
        }
        catch (const invalid_argument&) {
            cout << "Некоректний ввід. Будь ласка, введіть число або '/'.\n";
        }
    }
}

void DataProcessing() {
    while (true) {
        std::unique_lock<std::mutex> lk(m);
        dataCond.wait(lk, [] { return !dataQueue.empty(); });
        int i = dataQueue.front();
        dataQueue.pop();
        lk.unlock();

        if (i == -1) {
            break;
        }

        if (i <= 1) {
            cout << "\nЧисло " << i << " не є простим чи складеним\n";
            continue;
        }

        bool isPrime = true;
        for (int j = 2; j * j <= i; j++) {
            if (i % j == 0) {
                isPrime = false;
                break;
            }
        }
        if (isPrime) {
            cout << "\nЧисло " << i << " є простим\n";
        }
    }
}

int main() {
    SetConsoleOutputCP(1251);
    thread t1(DataPreparation);
    t1.detach();
    thread t2(DataProcessing);
    t2.join();

    return 0;
}


