void Awake() {
    this_thread::sleep_for(chrono::milliseconds(100));
    cout << "Розсилаю повідомлення\n";
    dataCond.notify_all();                       
    this_thread::sleep_for(chrono::milliseconds(100));
    {
        unique_lock<mutex> lk(m);
        i = 1;
    }
    cout << "Розсилаю повідомлення повторно, i=1\n";
    dataCond.notify_all();
}

int main() {
    SetConsoleOutputCP(1251);
    vector<thread> waiters;
    for (int k = 0; k < 3; k++) { 
        thread t(Waits);
        waiters.push_back(t);
    };

    thread t2(Awake);
    t2.join();                       
    for (auto& t : waiters) t.join(); 
    return 0;
}

