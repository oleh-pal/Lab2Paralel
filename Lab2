int CalcSimpleNum(int n) {
    if (n <= 0) return 0;
    vector<int> num(n);
    num[0] = 2;
    int N = 1;
    int Num = 3;
    for (int i = 0; N < n; i++) {
        bool isPrime = true;
        for (int j = 0; j < N; j++) {
            if (num[j] * num[j] > Num) { break; }
            if (Num % num[j] == 0) { isPrime = false; break; }
        }
        if (isPrime) {
            num[N] = Num;
            N++;
        }
        Num += 2;
    }
    return num[n - 1];
}

void Thread1(int n, promise<int> p_n, promise<bool> p_signal, promise<int> p_n10) {
    int prime_n = CalcSimpleNum(n);
    p_n.set_value(prime_n);
    p_signal.set_value(true);
    int prime_n10 = CalcSimpleNum(n * 10);
    p_n10.set_value(prime_n10);
}

void Thread2(int n, future<bool> f_signal) {
    bool signal_received = f_signal.get();

    if (signal_received) {
        this_thread::sleep_for(chrono::seconds(2));
        cout << "[Потік 2] Квадратний корінь від " << n << " = " << sqrt(n) << "\n";
    }
}

int main() {
    SetConsoleOutputCP(1251);

    int n;
    cout << "Введіть номер n для пошуку простого числа: ";
    cin >> n;
    promise<int> p_n;
    promise<bool> p_signal;
    promise<int> p_n10;

    future<int> f_n = p_n.get_future();
    future<bool> f_signal = p_signal.get_future();
    future<int> f_n10 = p_n10.get_future();

    thread t1(Thread1, n, std::move(p_n), std::move(p_signal), std::move(p_n10));
    thread t2(Thread2, n, std::move(f_signal));
    cout << "[Головний потік] " << n << "-те просте число: " << f_n.get() << "\n";

    cout << "[Головний потік] " << n * 10 << "-те просте число: " << f_n10.get() << "\n";
    t1.join();
    t2.join();

    return 0;
}

